{
  "name": "rute-antar",
  "version": "1.0.0",
  "description": "Perencanaan pengantaran distribusi Indonesia",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "admin:create": "node --env-file-if-exists=.env --import tsx scripts/create-admin.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "format": "prettier --write src tests scripts README.md",
    "test:db": "node --env-file=.env node_modules/vitest/vitest.mjs run tests/postgres.integration.test.ts",
    "test:http": "node --env-file-if-exists=.env --import tsx scripts/http-smoke.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.5.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "iron-session": "^9.0.1",
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module"
}

# Install dependencies and generate build output inside the image
**/node_modules
**/.next
out
dist
build
next-env.d.ts
**/*.tsbuildinfo
**/.npm
**/.pnpm-store
**/.yarn/cache
**/.yarn/unplugged
**/.yarn/install-state.gz
**/.pnp.*
**/.vercel
**/.turbo
